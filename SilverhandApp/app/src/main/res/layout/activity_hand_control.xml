<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <Button
        android:id="@+id/btn_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Close Hand (2)" />

    <Button
        android:id="@+id/btn_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Hand (3)" />

    <Button
        android:id="@+id/btn_calibrate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calibrate Feedback (6)" />

    <Button
        android:id="@+id/btn_record"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Record Gesture (7)" />

    <Button
        android:id="@+id/btn_play_fwd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Play Animation Forward (8)" />

    <Button
        android:id="@+id/btn_play_rev"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Play Animation Reverse (9)" />
</LinearLayout>